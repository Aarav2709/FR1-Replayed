settings = {
  orientation = {
    default = "landscapeRight",
    supported = { "landscapeLeft", "landscapeRight" },
  },
  win32 = {
    singleInstance = true,
  },
  window = {
    defaultMode = "fullscreen",
    defaultViewWidth = 1080,
    defaultViewHeight = 1920,
    resizable = true,
    minViewWidth = 320,
    minViewHeight = 480,
    enableMaximizeButton = true,
    enableMinimizeButton = true,
    enableCloseButton = true,
    suspendWhenMinimized = true,
    titleText = { default = "Fun Run 1: Replayed" },
  },
  android = {
    versionCode = "1",
    usesPermissions = {
      "android.permission.INTERNET",
      "android.permission.ACCESS_WIFI_STATE",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.CHANGE_WIFI_MULTICAST_STATE",
    },
  },
  iphone = {
    xcassets = "iOSResources/Images.xcassets",
    plist = {
      UIStatusBarHidden = true,
      UIPrerenderedIcon = true,
    },
  },
  excludeFiles = {
    all = { "DecompiledCode", "tools", "*.md", "*.bat", ".gitignore", "LICENSE", "autotest.cfg" },
    android = { "Icon-win32.ico", "iOSResources/*" },
    iphone = { "Icon-win32.ico", "AndroidResources/*" },
    win32 = { "AndroidResources/*", "iOSResources/*" },
  },
}
